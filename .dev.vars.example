# Copy to .dev.vars for local development (`wrangler dev` reads it automatically).
# In production every one of these is set with `wrangler secret put <NAME>`.

# Credential pepper/rate-limit root. Generate with: openssl rand -hex 32
# Keep this stable: rotation requires account password resets after bootstrap.
SESSION_SECRET=change-me

# Initial admin bootstrap only. Choose a unique 8-128 character password.
# Once bootstrapped, database credentials replace these for login/recovery.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Bearer token for the programmatic /api/v1/ endpoints.
# Generate with: openssl rand -hex 32. Leave empty to disable the v1 API.
API_BEARER_TOKEN=

# Optional ntfy.sh-compatible endpoint for push notifications on
# uploads/downloads, e.g. https://ntfy.sh/your-private-topic
NTFY_URL=

# Optional transactional mail (server only). Welcome/reset mail cannot be opted out.
# For a private credential file, run npm run mail:configure instead of copying keys.
# Optional activity emails are separately default-off in Account > Email preferences.
TRANSACTIONAL_MAIL_API_URL=
TRANSACTIONAL_MAIL_API_KEY=

# R2 S3-compatible API credentials, used to sign presigned upload/download
# URLs so file bytes go browser <-> R2 directly (never through the Worker).
# Create in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# (permission: Object Read & Write, scoped to your bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Your Cloudflare account id (Dashboard -> Workers & Pages -> right sidebar).
R2_ACCOUNT_ID=
